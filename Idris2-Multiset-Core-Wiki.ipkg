package Idris2-Multiset-Core-Wiki
version = 0.1.0
authors = "Justin Kelly"
brief   = "Verification executable for Layer 0 Ground Linear QTT Multiset Memory Kernel."
opts    = "--codegen chez"

depends = Idris2-Multiset-Core, Idris2-Multiset-Transform, base, idris2-QuickCheck, linear
sourcedir = "Library"

modules = Wiki.BitGateChannelSpec,
          Wiki.BoxIntAlgebraSpec,
          Wiki.CoreMacroAudit,
          Wiki.DependentMultisetSpec,
          Wiki.FusedStreamAlgebraSpec,
          Wiki.Generators,
          Wiki.LinearResourceChannelSpec,
          Wiki.Main,
          Wiki.MonoidApplicativeAdjunctionSpec,
          Wiki.MultisetAlgebraSpec,
          Wiki.ScaleTransformSpec

main = Wiki.Main
executable = multiset-core-wiki
